    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\n\nconst ds =\n  response.parameters?.ds ??\n  response.ds ??\n  response;\n\nconst receiptLines = Array.isArray(ds.RcvDtl)\n  ? ds.RcvDtl\n  : [];\n\nconst lines = receiptLines.map(line => ({\n  po_number: line.PONum,\n  po_line: line.POLine,\n  po_release: line.PORelNum,\n  pack_line: line.PackLine,\n\n  part_number: line.PartNum,\n  description: line.PartDescription || line.POLineLineDesc || \"\",\n\n  ordered_quantity: Number(line.OrderQty ?? 0),\n  previously_received_quantity: Number(line.PORelArrivedQty ?? 0),\n  available_quantity: Number(line.OurRemQty ?? 0),\n\n  receipt_quantity: Number(line.ThisTranQty ?? 0),\n\n  unit: line.IUM,\n  vendor_unit: line.PUM,\n\n  warehouse: line.WareHouseCode,\n  bin: line.BinNum,\n\n  inspection_required: Boolean(line.InspectionReq),\n  lot_required: Boolean(line.EnableLot),\n  serial_required: Boolean(line.EnableSN)\n}));\n\nreturn [{\n  json: {\n    success: true,\n    po_number: lines[0]?.po_number ?? null,\n    total_lines: lines.length,\n    lines\n  }\n}];"
      },
