    {
      "parameters": {
        "jsCode": "const input = $('Webhook').first().json.body;\n\nconst response = $input.first().json;\nconst ds = response.parameters?.ds ?? response.ds?.ds ?? response.ds ?? response;\n\nif (!Array.isArray(ds.RcvDtl)) {\n  throw new Error(\"Receipt details not found.\");\n}\n\nif (!Array.isArray(input.lines) || input.lines.length === 0) {\n  throw new Error(\"No receipt lines submitted.\");\n}\n\nconst seen = new Set();\n\nfor (const submitted of input.lines) {\n  const quantity = Number(submitted.received_quantity);\n\n  if (!Number.isFinite(quantity) || quantity <= 0) {\n    throw new Error(`Invalid quantity for ${submitted.part_number}`);\n  }\n\n  const key = [\n    submitted.po_line,\n    submitted.po_release,\n    submitted.pack_line\n  ].join(\"-\");\n\n  if (seen.has(key)) {\n    throw new Error(`Duplicate receipt line: ${key}`);\n  }\n\n  seen.add(key);\n\n  const line = ds.RcvDtl.find(item =>\n    Number(item.POLine) === Number(submitted.po_line) &&\n    Number(item.PORelNum) === Number(submitted.po_release) &&\n    Number(item.PackLine) === Number(submitted.pack_line) &&\n    item.PartNum === submitted.part_number\n  );\n\n  if (!line) {\n    throw new Error(`Part not found: ${submitted.part_number}`);\n  }\n\n  const available = Number(line.OurRemQty ?? 0);\n\n  if (quantity > available) {\n    throw new Error(\n      `${line.PartNum}: quantity exceeds available quantity (${available}).`\n    );\n  }\n\n  if (line.IUM !== line.PUM) {\n    throw new Error(\n      `${line.PartNum}: different vendor and inventory UOM. Conversion is required.`\n    );\n  }\n\n  line.OurQty = quantity;\n  line.InputOurQty = quantity;\n  line.ThisTranQty = quantity;\n  line.VendorQty = quantity;\n}\n\nreturn [{\n  json: {\n    vendor_num: input.vendor_num,\n    pur_point: input.pur_point ?? \"\",\n    pack_slip: input.pack_slip,\n    parameters: {\n      ds: ds\n    }\n  }\n}];"
      },
