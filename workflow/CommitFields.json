      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const ds = item.json.parameters.ds;\n\n  ds.RcvHead = (ds.RcvHead || []).map(h => ({\n    ...h,\n    Received: true,\n    RowMod: h.RowMod || 'U'\n  }));\n\n  ds.RcvDtl = (ds.RcvDtl || []).map(r => ({\n    ...r,\n    Selected: true,\n    Received: true\n  }));\n\n  return item;\n});"
