    {
      "parameters": {
        "jsCode": "// Runs AFTER Epicor's OnChangeDtlPOSelected (which fills in defaults) and BEFORE ReceiveAll.\nconst input = $('Normalize Input').first().json;\nconst prep = $('Code in JavaScript').first().json;\nconst ds = $('OnChangeDtlPOSelected').first().json.parameters.ds;\nconst rows = ds.RcvDtl || [];\nconst keyOf = r => `${r.PONum}-${r.POLine}-${r.PORelNum}`;\n\nif (input.receive_all === false) {\n  const qtyByKey = prep.qtyByKey || {};\n  const kept = rows\n    .filter(r => r.Selected && keyOf(r) in qtyByKey)\n    .map(r => ({ ...r, OurQty: qtyByKey[keyOf(r)], VendorQty: qtyByKey[keyOf(r)] }));\n  if (!kept.length) throw new Error('None of the scanned lines matched the PO lines Epicor returned.');\n  ds.RcvDtl = kept;   // only the chosen lines go on to ReceiveAll / Commit\n}\n// FULL receipt: ds passes through untouched, exactly like before.\nreturn [{ json: { ds } }];\n"
      },
