      "id": "9969897f-57f1-4f7f-9cd6-ef7dc4d090a9",
      "name": "filter check"
    },
    {
      "parameters": {
        "jsCode": "// Decides which PO lines get received, BEFORE Epicor's OnChangeDtlPOSelected runs.\n// receive_all = true  -> FULL receipt: every PO line (same as your old workflow)\n// receive_all = false -> PARTIAL receipt: only the scanned part codes, with typed quantities\nconst input = $('Normalize Input').first().json;\nconst ds = $('CreateMassReceipts').first().json.parameters.ds;\nconst rows = ds.RcvDtl || [];\nconst fail = (message, extra = {}) => [{ json: { ok: false, message, ...extra } }];\nconst keyOf = r => `${r.PONum}-${r.POLine}-${r.PORelNum}`;\n\nif (!rows.length) return fail('Epicor returned no open PO lines for this PO / vendor / pack slip.');\n\nif (input.receive_all === false) {\n  const wanted = Array.isArray(input.lines) ? input.lines : [];\n  if (!wanted.length) return fail('Partial receipt needs at least one scanned part with a quantity.');\n\n  const norm = s => String(s ?? '').trim().toUpperCase();\n  const qtyByKey = {};\n  const problems = [];\n\n  for (const w of wanted) {\n    const part = norm(w.part_num);\n    const qty = Number(w.qty);\n    if (!part) { problems.push('A line has no part number.'); continue; }\n    if (!Number.isFinite(qty) || qty <= 0) { problems.push(`${w.part_num}: quantity must be greater than 0.`); continue; }\n\n    let matches = rows.filter(r => norm(r.PartNum) === part);\n    if (w.po_line !== undefined && w.po_line !== null && w.po_line !== '') {\n      matches = matches.filter(r => Number(r.POLine) === Number(w.po_line));\n    }\n    if (!matches.length) { problems.push(`${w.part_num}: not on this PO.`); continue; }\n    if (matches.length > 1) {\n      problems.push(`${w.part_num}: on several PO lines (${matches.map(r => r.POLine).join(', ')}). Send po_line as well.`);\n      continue;\n    }\n    const k = keyOf(matches[0]);\n    if (k in qtyByKey) { problems.push(`${w.part_num}: scanned twice. Send one combined quantity.`); continue; }\n    qtyByKey[k] = qty;\n  }\n\n  if (problems.length) return fail(problems.join(' '), { problems });\n\n  ds.RcvDtl = rows.map(r => ({ ...r, Selected: keyOf(r) in qtyByKey }));\n  return [{ json: { ok: true, poNum: '0', ds, qtyByKey } }];\n}\n\n// FULL receipt\nds.RcvDtl = rows.map(r => ({ ...r, Selected: true }));\nreturn [{ json: { ok: true, poNum: '0', ds, qtyByKey: null } }];\n"
      },
