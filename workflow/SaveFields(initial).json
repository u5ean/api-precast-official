      "parameters": {
        "jsCode": "const ds = $input.first().json.parameters?.ds ?? {};\nreturn [{ json: {\n  rcvdtl_rows: (ds.RcvDtl || []).length,\n  row_mods: (ds.RcvDtl || []).map(r => r.RowMod),\n  qtys: (ds.RcvDtl || []).map(r => r.OurQty),\n  selected: (ds.RcvDtl || []).map(r => r.Selected)\n}}];"
